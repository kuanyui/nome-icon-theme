<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Delete Out of Page Objects</name>
    <id>my.delete_out_of_page</id>
    <effect needs-live-preview="false">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="AAA"> </submenu>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">delete_out_of_page.py</command>
    </script>
</inkscape-extension>